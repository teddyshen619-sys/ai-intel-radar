{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent 实战教学平台课程目录 V4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guides"
  ],
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "guides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Guide"
      },
      "minItems": 0,
      "description": "允许空课程库；有课程时按 order 升序。打包器在跨文件范围校验 id、order 唯一。"
    }
  },
  "$defs": {
    "Guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "track",
        "title",
        "summary",
        "updated_at",
        "author_note",
        "related_tags",
        "source_file",
        "body_markdown",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "track": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "revising"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "author_note": {
          "type": "string"
        },
        "related_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "body_markdown": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "markdown",
        "code_blocks",
        "risk_notes"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "code_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeBlock"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CodeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "code"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    }
  }
}
